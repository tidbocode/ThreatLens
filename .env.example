# Ollama settings (must be running locally: ollama serve)
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=mistral:7b
EMBED_MODEL=nomic-embed-text

# Optional: AlienVault OTX API key (free at https://otx.alienvault.com)
OTX_API_KEY=

# Optional overrides
CHROMA_PATH=./chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=5
